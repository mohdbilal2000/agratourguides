---
/**
 * Editorial destinations grid. Three featured cities in an asymmetric
 * 2-col layout: large feature card on the left, two stacked on the right.
 * Replaces the 4-tile bento with promotional info-card.
 *
 * Photography is from curated Unsplash; swap to owned later via single-line edits.
 */
import { Image } from "astro:assets";
import SectionHeader from "../ui/SectionHeader.astro";
import Reveal from "../ui/Reveal.astro";

interface Destination {
  name: string;
  href: string;
  image: string;
  alt: string;
  meta: string;
  blurb: string;
}

const destinations: Destination[] = [
  {
    name: "Agra",
    href: "/agra/",
    image: "https://images.unsplash.com/photo-1564507592333-c60657eea523?w=1600&q=85&auto=format&fit=crop",
    alt: "Taj Mahal at sunrise reflected in the central pool, Agra",
    meta: "4 monuments · sunrise Taj recommended",
    blurb: "Our home base. The Taj, the Agra Fort, Fatehpur Sikri, and the quiet Baby-Taj at golden hour.",
  },
  {
    name: "Delhi",
    href: "/delhi/",
    image: "https://images.unsplash.com/photo-1587474260584-136574528ed5?w=1200&q=85&auto=format&fit=crop",
    alt: "Red Fort sandstone walls in Old Delhi",
    meta: "5 monuments · old + new in one day",
    blurb: "Red Fort, Qutub Minar, Humayun's Tomb — the Mughal capital in a single arc.",
  },
  {
    name: "Jaipur",
    href: "/jaipur/",
    image: "https://images.unsplash.com/photo-1477587458883-47145ed94245?w=1200&q=85&auto=format&fit=crop",
    alt: "Hawa Mahal pink-sandstone facade with 953 windows, Jaipur",
    meta: "5 monuments · Amber Fort at first light",
    blurb: "The Pink City. Amber Fort, Hawa Mahal, City Palace, Jantar Mantar — and the slow afternoons in between.",
  },
];

const [primary, ...secondary] = destinations;
---

<section class="bg-[var(--background)] py-24 md:py-32" id="destinations" aria-labelledby="destinations-heading">
  <div class="mx-auto max-w-[var(--site-max)] px-4 sm:px-6 lg:px-8">

    <Reveal variant="fade">
      <SectionHeader
        eyebrow="The Golden Triangle"
        heading="Three cities. Six centuries of architecture. One unhurried journey."
        lede="We design the route around your pace, not a coach window. Same-day, overnight, or the slower five-day arc that most travellers wish they'd booked."
        align="left"
        as="h2"
        class="mb-14"
      />
    </Reveal>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6">

      {/* ── Primary: full-bleed feature card */}
      <a
        href={primary.href}
        class="reveal group relative block overflow-hidden rounded-2xl bg-[var(--color-ink-900)] aspect-[5/6] lg:aspect-auto lg:row-span-2 target-auto"
        data-on-dark
      >
        <Image
          src={primary.image}
          alt={primary.alt}
          width={1600}
          height={1920}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          format="webp"
          quality={82}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover img-zoom"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
        <div class="relative z-10 flex h-full flex-col justify-end p-7 md:p-10 lg:p-12">
          <p class="eyebrow text-[var(--color-gold-300)]">
            <span aria-hidden="true" class="block h-px w-8 bg-current opacity-70"></span>
            {primary.meta}
          </p>
          <h3 class="mt-3 text-white text-balance" style="font-size: var(--text-5xl); font-variation-settings: 'opsz' 144, 'SOFT' 100;">
            {primary.name}
          </h3>
          <p class="mt-4 max-w-md text-white/80 text-pretty leading-relaxed" style="font-size: var(--text-base);">
            {primary.blurb}
          </p>
          <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white target-auto">
            See itineraries
            <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>

      {/* ── Secondary stack */}
      {secondary.map((d, i) => (
        <a
          href={d.href}
          class="reveal group relative block overflow-hidden rounded-2xl bg-[var(--color-ink-900)] aspect-[16/10] target-auto"
          data-on-dark
          style={`animation-delay: ${(i + 1) * 120}ms;`}
        >
          <Image
            src={d.image}
            alt={d.alt}
            width={1200}
            height={750}
            widths={[480, 720, 960, 1200]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            format="webp"
            quality={82}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover img-zoom"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
          <div class="relative z-10 flex h-full flex-col justify-end p-6 md:p-7">
            <p class="eyebrow text-[var(--color-gold-300)]" style="font-size: 0.7rem;">
              {d.meta}
            </p>
            <h3 class="mt-2 text-white text-balance" style="font-size: var(--text-3xl); font-variation-settings: 'opsz' 72, 'SOFT' 60;">
              {d.name}
            </h3>
            <p class="mt-2 text-sm text-white/75 max-w-md leading-relaxed">
              {d.blurb}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
