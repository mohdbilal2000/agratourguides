---
/**
 * Editorial tours rail. Snap-scroll on mobile, 3-col grid on desktop.
 * Cards lean editorial: large photo, eyebrow with category + duration,
 * Fraunces headline, single-line summary, tailoring cue in JetBrains mono.
 */
import { Image } from "astro:assets";
import SectionHeader from "../ui/SectionHeader.astro";
import Reveal from "../ui/Reveal.astro";

interface Tour {
  href: string;
  image: string;
  alt: string;
  title: string;
  summary: string;
  duration: string;
  category: string;
  /** One-line cue for how this template gets adapted to the traveller. */
  shape: string;
}

const tours: Tour[] = [
  {
    href: "/tours/same-day-agra-from-delhi/",
    image: "https://images.unsplash.com/photo-1564507592333-c60657eea523?w=1200&q=85&auto=format&fit=crop",
    alt: "Taj Mahal at first light",
    title: "Same-day Agra from Delhi",
    summary: "Yamuna Expressway at dawn. Sunrise Taj. Agra Fort. Back by dinner.",
    duration: "14 hours",
    category: "Day trip",
    shape: "Sunrise or sunset start",
  },
  {
    href: "/tours/golden-triangle-3-days/",
    image: "https://images.unsplash.com/photo-1599661046289-e31897846e41?w=1200&q=85&auto=format&fit=crop",
    alt: "Amber Fort hillside in Jaipur",
    title: "Golden Triangle, three days",
    summary: "Delhi to Agra to Jaipur. The classic arc, paced for travellers who plan to come back.",
    duration: "3 days",
    category: "Multi-day",
    shape: "Stretch to 4–5 days",
  },
  {
    href: "/tours/jaipur-day-tour/",
    image: "https://images.unsplash.com/photo-1477587458883-47145ed94245?w=1200&q=85&auto=format&fit=crop",
    alt: "Hawa Mahal facade in Jaipur",
    title: "Jaipur in a day",
    summary: "Amber Fort at first light, then Hawa Mahal, City Palace and Jantar Mantar before sunset.",
    duration: "10 hours",
    category: "Day trip",
    shape: "Add Nahargarh sunset",
  },
];
---

<section class="py-24 md:py-32 bg-[var(--background-alt)]" aria-labelledby="tours-heading">
  <div class="mx-auto max-w-[var(--site-max)] px-4 sm:px-6 lg:px-8">

    <div class="flex items-end justify-between gap-6 mb-12 md:mb-16">
      <Reveal variant="fade">
        <SectionHeader
          eyebrow="Featured tours"
          heading="Three itineraries we'd book ourselves."
          lede="The most-asked tours, paced the way locals would do them."
          align="left"
          as="h2"
        />
      </Reveal>
      <a
        href="/tours/"
        class="hidden md:inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-gold-700)] hover:text-[var(--color-gold-800)] transition-colors shrink-0 mb-2 target-auto"
      >
        All tours
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <ul
      class="
        flex md:grid md:grid-cols-3
        gap-5 md:gap-7
        overflow-x-auto md:overflow-visible
        snap-x snap-mandatory md:snap-none
        -mx-4 md:mx-0 px-4 md:px-0
        no-scrollbar
        target-auto
      "
      role="list"
    >
      {tours.map((t, i) => (
        <li
          class="reveal w-[80vw] max-w-[340px] md:w-auto md:max-w-none flex-shrink-0 snap-start target-auto"
          style={`animation-delay: ${i * 100}ms;`}
        >
          <a
            href={t.href}
            class="group block h-full overflow-hidden rounded-2xl bg-[var(--background)] border border-[var(--border)] hover-lift target-auto"
          >
            <div class="relative aspect-[4/5] md:aspect-[5/6] overflow-hidden bg-[var(--color-sandstone-100)]">
              <Image
                src={t.image}
                alt={t.alt}
                width={1200}
                height={1500}
                widths={[400, 640, 960, 1200]}
                sizes="(max-width: 768px) 80vw, 30vw"
                format="webp"
                quality={82}
                loading="lazy"
                class="h-full w-full object-cover img-zoom"
              />
              <div class="absolute inset-x-0 top-0 p-4 flex items-center justify-between text-[11px] tracking-widest uppercase font-semibold text-white/95">
                <span class="rounded-full bg-black/40 backdrop-blur-md px-3 py-1.5">{t.category}</span>
                <span class="rounded-full bg-black/40 backdrop-blur-md px-3 py-1.5">{t.duration}</span>
              </div>
            </div>

            <div class="flex flex-col gap-3 p-6 md:p-7">
              <h3 class="text-balance" style="font-size: var(--text-2xl); font-variation-settings: 'opsz' 32, 'SOFT' 30;">
                {t.title}
              </h3>
              <p class="text-sm text-[var(--foreground-muted)] leading-relaxed text-pretty">
                {t.summary}
              </p>
              <div class="mt-2 flex items-baseline justify-between border-t border-[var(--border)] pt-4">
                <div>
                  <span class="block text-[10px] uppercase tracking-widest text-[var(--foreground-subtle)]">Customisable</span>
                  <span class="text-mono text-sm text-[var(--foreground)]" style="font-variation-settings: 'wght' 500;">
                    {t.shape}
                  </span>
                </div>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-gold-700)] group-hover:text-[var(--color-gold-800)] transition-colors target-auto">
                  Plan
                  <svg class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-10 text-center md:hidden">
      <a
        href="/tours/"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-gold-700)] hover:text-[var(--color-gold-800)] transition-colors target-auto"
      >
        All tours
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
