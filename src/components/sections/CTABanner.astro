---
/**
 * Final-CTA editorial banner. Single huge editorial headline; one primary
 * action; one quiet WhatsApp fallback. Background is a soft sandstone
 * gradient, not a photograph — the page already has plenty of imagery,
 * this section earns its quiet.
 */
import { WHATSAPP_NUMBER_DIGITS } from "../../lib/constants";

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  title = "Ready when you are.",
  subtitle = "Tell us your travel dates and we'll send a full itinerary, in your currency, within two hours.",
  ctaText = "Get my itinerary",
  ctaLink = "/contact/",
} = Astro.props;

const waUrl = `https://wa.me/${WHATSAPP_NUMBER_DIGITS}?text=${encodeURIComponent("Hi! I'd like to plan a tour with Agra Tour Guides.")}`;
---

<section
  class="relative overflow-hidden bg-[var(--color-ink-950)] text-white"
  data-on-dark
  aria-label="Plan your trip"
>
  {/* Decorative warm radial */}
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none opacity-[0.12]"
    style="background: radial-gradient(circle at 25% 50%, var(--color-gold-400) 0%, transparent 55%), radial-gradient(circle at 90% 20%, var(--color-gold-700) 0%, transparent 50%);">
  </div>

  <div class="relative mx-auto max-w-[var(--site-max)] px-4 sm:px-6 lg:px-8 py-24 md:py-36">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow text-[var(--color-gold-300)]">
          <span aria-hidden="true" class="block h-px w-10 bg-current opacity-70"></span>
          Plan your trip
        </p>
        <h2 class="reveal mt-6 text-white text-balance" style="font-size: var(--text-6xl); font-variation-settings: 'opsz' 144, 'SOFT' 100;">
          {title}
        </h2>
        <p class="reveal-fade mt-6 text-white/75 text-pretty max-w-xl" style="font-size: var(--text-lg);">
          {subtitle}
        </p>
      </div>

      <div class="lg:col-span-4 flex flex-col gap-3 lg:items-end">
        <a
          href={ctaLink}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--color-gold-500)] hover:bg-[var(--color-gold-400)] text-[var(--color-ink-950)] px-8 py-4 text-base font-semibold transition-colors target-auto"
        >
          {ctaText}
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/20 hover:border-white/40 text-white px-8 py-4 text-base font-medium transition-colors target-auto"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347" />
          </svg>
          Or WhatsApp now
        </a>
      </div>
    </div>
  </div>
</section>
