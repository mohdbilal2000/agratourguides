---
/**
 * Editorial split-screen hero. Solid sandstone-deep left half carries the
 * copy at world-class contrast (AA on body, AAA on headline); cinematic
 * photograph occupies the right half. On mobile, photo stacks below copy.
 *
 * Why split-screen: putting a kinetic Fraunces headline on top of a bright
 * monument photo destroys legibility no matter how thick the overlay. The
 * 2024–26 editorial standard (Hermès journal, NYT travel longform, Apple's
 * heritage pages) is to give text a solid canvas and the photograph its own.
 */
import { Image } from "astro:assets";
import KineticHeadline from "../ui/KineticHeadline.astro";
import { WHATSAPP_NUMBER_DIGITS, REVIEW_COUNT } from "../../lib/constants";

interface Props {
  eyebrow?: string;
  leadIn?: string;
  punch?: string;
  lede?: string;
  backgroundImage?: string;
  backgroundAlt?: string;
}

const {
  eyebrow = "Heritage travel · Since 2014",
  leadIn = "Private Taj Mahal tours,",
  punch = "by the people who grew up there.",
  lede = "Government-licensed guides, itineraries built around your dates rather than a fixed package, and the kind of photography travellers come back wishing they'd known about.",
  backgroundImage = "https://images.unsplash.com/photo-1564507592333-c60657eea523?w=2000&q=85&auto=format&fit=crop",
  backgroundAlt = "Taj Mahal at first light, viewed from the eastern minaret",
} = Astro.props;

const waUrl = `https://wa.me/${WHATSAPP_NUMBER_DIGITS}?text=${encodeURIComponent("Hi! I'd like to book a Taj Mahal tour.")}`;
---

<section
  class="relative bg-[var(--color-ink-950)] text-white"
  data-on-dark
  aria-label="Welcome"
>
  <div class="grid grid-cols-1 lg:grid-cols-12" style="min-height: 92vh; min-height: 92svh;">

    {/* ── LEFT: copy (solid sandstone, AA contrast guaranteed) */}
    <div class="lg:col-span-6 xl:col-span-5 relative flex flex-col justify-end px-6 sm:px-10 lg:px-16 pt-24 lg:pt-36 pb-14 lg:pb-20 bg-[var(--color-ink-950)]">

      {/* Decorative warm corner — subtle, doesn't fight copy */}
      <div aria-hidden="true" class="absolute inset-0 pointer-events-none opacity-[0.18]"
        style="background: radial-gradient(circle at 0% 0%, var(--color-gold-700) 0%, transparent 55%);"></div>

      <div class="relative flex flex-col gap-6 md:gap-7 max-w-2xl">
        <p class="eyebrow text-[var(--color-gold-300)]">
          <span aria-hidden="true" class="block h-px w-10 bg-current opacity-70"></span>
          {eyebrow}
        </p>

        <h1 class="heading-display text-white text-balance" style="font-size: var(--text-6xl); max-width: 16ch;">
          <KineticHeadline as="span" text={leadIn} stagger={80} class="block text-white" />
          <KineticHeadline
            as="span"
            text={punch}
            stagger={70}
            delay={420}
            italic
            class="block mt-1 text-white/95"
          />
        </h1>

        <p class="reveal-fade text-pretty text-white/80 leading-relaxed max-w-prose" style="font-size: var(--text-lg); animation-delay: 900ms;">
          {lede}
        </p>

        <div class="reveal-fade flex flex-wrap items-center gap-x-6 gap-y-3" style="animation-delay: 1100ms;">
          <a
            href="/tours/"
            class="inline-flex items-center gap-2 rounded-full bg-[var(--color-gold-500)] text-[var(--color-ink-950)] px-7 py-3.5 text-sm font-semibold tracking-tight shadow-lg shadow-black/30 hover:bg-[var(--color-gold-400)] transition-colors target-auto"
          >
            Explore tours
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-white/90 hover:text-white underline-offset-4 hover:underline transition-colors target-auto"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
            </svg>
            Or message us — quote in 2 hours
          </a>
        </div>

        <div class="reveal-fade flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-white/70" style="animation-delay: 1300ms;">
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-[var(--color-gold-400)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            5.0 / 5 on Google
          </span>
          <span aria-hidden="true" class="opacity-40">·</span>
          <span>{REVIEW_COUNT}+ verified reviews</span>
          <span aria-hidden="true" class="opacity-40">·</span>
          <span>Govt-licensed, ASI-badged</span>
          <span aria-hidden="true" class="opacity-40">·</span>
          <span>English · Hindi · Japanese</span>
        </div>
      </div>
    </div>

    {/* ── RIGHT: photograph */}
    <div class="lg:col-span-6 xl:col-span-7 relative overflow-hidden bg-[var(--color-ink-900)] aspect-[4/5] sm:aspect-[16/10] lg:aspect-auto">
      <div class="absolute inset-0 hero-bg" data-hero-parallax>
        <Image
          src={backgroundImage}
          alt={backgroundAlt}
          width={2000}
          height={2400}
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="(max-width: 1024px) 100vw, 60vw"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover scale-[1.08]"
        />
      </div>
      {/* Left-edge blend wash + bottom scrim for caption AA contrast */}
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-[var(--color-ink-950)]/40 lg:from-[var(--color-ink-950)]/60 via-transparent to-transparent"></div>
      <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/55 to-transparent"></div>
      {/* Bottom caption — readable inside the scrim */}
      <p class="absolute bottom-5 right-6 lg:bottom-7 lg:right-10 text-[10px] tracking-[0.18em] uppercase text-white/85 font-semibold target-auto">
        Taj Mahal · East Gate · 06:24 IST
      </p>
    </div>
  </div>
</section>

<style>
  /* Cursor-tracked parallax on desktop only. */
  @media (hover: hover) and (pointer: fine) {
    .hero-bg {
      transform: translate3d(var(--hero-x, 0), var(--hero-y, 0), 0);
      transition: transform 1000ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg { transform: none !important; transition: none !important; }
  }
</style>

<script>
  function initHeroParallax() {
    const el = document.querySelector("[data-hero-parallax]") as HTMLElement | null;
    if (!el) return;
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!canHover || reduced) return;

    let rafId = 0;
    let tx = 0, ty = 0;
    const onMove = (e: PointerEvent) => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      tx = ((e.clientX / w) - 0.5) * -16;
      ty = ((e.clientY / h) - 0.5) * -10;
      if (!rafId) rafId = requestAnimationFrame(apply);
    };
    const apply = () => {
      el.style.setProperty("--hero-x", `${tx.toFixed(2)}px`);
      el.style.setProperty("--hero-y", `${ty.toFixed(2)}px`);
      rafId = 0;
    };
    document.addEventListener("pointermove", onMove, { passive: true });
  }

  initHeroParallax();
  document.addEventListener("astro:after-swap", initHeroParallax);
</script>
