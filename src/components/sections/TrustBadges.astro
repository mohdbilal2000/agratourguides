---
/**
 * Quiet trust strip. Replaces the previous big-numbers grid which competed
 * with the hero's KPI line. This is intentionally subdued — a single line
 * that anchors the page after the hero punch.
 */
import { REVIEW_COUNT, REVIEW_RATING } from "../../lib/constants";

const items = [
  { value: `${REVIEW_RATING.toFixed(1)} / 5`, label: "verified Google rating" },
  { value: `${REVIEW_COUNT}+`, label: "real travellers, 30+ countries" },
  { value: "Govt.", label: "Ministry of Tourism licensed" },
  { value: "ASI", label: "badge holder — Taj Mahal access" },
];
---

<section
  id="discover"
  class="border-y border-[var(--border)] bg-[var(--background)]"
  aria-label="Trust signals"
>
  <div class="mx-auto max-w-[var(--site-max)] px-4 sm:px-6 lg:px-8">
    <ul class="reveal-fade grid grid-cols-2 md:grid-cols-4 divide-x divide-[var(--border)] -mx-4 md:-mx-0 target-auto" role="list">
      {items.map((it, i) => (
        <li class:list={[
          "px-4 md:px-6 py-7 md:py-9 target-auto",
          i >= 2 ? "border-t md:border-t-0 border-[var(--border)]" : ""
        ]}>
          <p class="text-mono text-2xl md:text-3xl text-[var(--foreground)] tracking-tight" style="font-variation-settings: 'wght' 500;">
            {it.value}
          </p>
          <p class="mt-1.5 text-xs md:text-sm text-[var(--foreground-muted)] leading-snug">
            {it.label}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
