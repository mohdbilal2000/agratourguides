---
/**
 * Editorial review column. One large featured quote that anchors the
 * section, with two smaller supporting reviews below. Replaces the
 * three-equal-card grid — single hero quote reads as confident, not
 * insecure.
 *
 * Markup uses schema.org/Review microdata so the quotes are crawlable
 * even before the page-level JSON-LD is read.
 */
import { REAL_REVIEWS } from "../../lib/reviews";
import { REVIEW_COUNT, REVIEW_RATING } from "../../lib/constants";
import Reveal from "../ui/Reveal.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const flagMap: Record<string, string> = {
  "Czech Republic": "\u{1F1E8}\u{1F1FF}",
  Germany: "\u{1F1E9}\u{1F1EA}",
  Australia: "\u{1F1E6}\u{1F1FA}",
  India: "\u{1F1EE}\u{1F1F3}",
  Italy: "\u{1F1EE}\u{1F1F9}",
  "United Kingdom": "\u{1F1EC}\u{1F1E7}",
  "United States": "\u{1F1FA}\u{1F1F8}",
  France: "\u{1F1EB}\u{1F1F7}",
  Spain: "\u{1F1EA}\u{1F1F8}",
  Netherlands: "\u{1F1F3}\u{1F1F1}",
  Japan: "\u{1F1EF}\u{1F1F5}",
  Canada: "\u{1F1E8}\u{1F1E6}",
  Belgium: "\u{1F1E7}\u{1F1EA}",
  Singapore: "\u{1F1F8}\u{1F1EC}",
  "United Arab Emirates": "\u{1F1E6}\u{1F1EA}",
  Ireland: "\u{1F1EE}\u{1F1EA}",
  "South Africa": "\u{1F1FF}\u{1F1E6}",
  Egypt: "\u{1F1EA}\u{1F1EC}",
  Oman: "\u{1F1F4}\u{1F1F2}",
  Iran: "\u{1F1EE}\u{1F1F7}",
  Kenya: "\u{1F1F0}\u{1F1EA}",
  Malaysia: "\u{1F1F2}\u{1F1FE}",
  Mauritius: "\u{1F1F2}\u{1F1FA}",
};

// Hero quote: Mike Cordery, Australia — long, specific, multi-claim ("creative
// photographer, funny storyteller, knowledgeable historian, fluent Japanese").
const hero = REAL_REVIEWS.find((r) => r.author === "Mike Cordery")!;

// Supporting quotes: shorter, geographically diverse.
const supporting = [
  REAL_REVIEWS.find((r) => r.author === "Klára Holubová")!,
  REAL_REVIEWS.find((r) => r.author === "Karin Stehr")!,
];
---

<section class="py-24 md:py-32 bg-[var(--background)]" aria-labelledby="reviews-heading">
  <div class="mx-auto max-w-[var(--site-max)] px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-16">

      {/* Left rail: section context */}
      <Reveal variant="fade" class="lg:col-span-4 lg:sticky lg:top-32 lg:self-start">
        <Eyebrow>Reviews</Eyebrow>
        <h2 id="reviews-heading" class="mt-5 text-balance" style="font-size: var(--text-4xl); font-variation-settings: 'opsz' 96, 'SOFT' 50;">
          {REVIEW_RATING.toFixed(1)} / 5 from
          <em class="italic font-normal text-[var(--foreground-muted)]" style="font-variation-settings: 'opsz' 72, 'WONK' 1;">
            {REVIEW_COUNT}+ travellers
          </em>
          across 30+ countries.
        </h2>
        <p class="mt-5 text-pretty text-[var(--foreground-muted)] leading-relaxed">
          Every review here is verified on our Google Business Profile. No edits, no curation tricks — read all of them in full on the reviews page.
        </p>
        <a href="/reviews/" class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-gold-700)] hover:text-[var(--color-gold-800)] transition-colors target-auto">
          Read all {REVIEW_COUNT}+ reviews
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </Reveal>

      {/* Right column: hero quote + supporting */}
      <div class="lg:col-span-8 flex flex-col gap-10">
        <Reveal class="relative">
          <figure itemscope itemtype="https://schema.org/Review" class="relative pl-8 md:pl-12">
            <meta itemprop="datePublished" content={hero.datePublished} />
            <div itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating">
              <meta itemprop="ratingValue" content={String(hero.rating)} />
              <meta itemprop="bestRating" content="5" />
            </div>
            {/* Editorial quotation mark — Fraunces italic, big, gold */}
            <span
              aria-hidden="true"
              class="absolute left-0 top-0 leading-none text-[var(--color-gold-400)] italic select-none"
              style="font-family: var(--font-display); font-size: clamp(4rem, 8vw, 7rem); font-variation-settings: 'opsz' 144, 'WONK' 1;"
            >“</span>
            <blockquote
              itemprop="reviewBody"
              class="text-balance text-[var(--foreground)] leading-snug"
              style="font-size: var(--text-3xl); font-variation-settings: 'opsz' 72, 'SOFT' 50;"
            >
              {hero.text}
            </blockquote>
            <figcaption class="mt-7 flex items-center justify-between gap-4 border-t border-[var(--border)] pt-5">
              <div itemprop="author" itemscope itemtype="https://schema.org/Person" class="flex items-center gap-3">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-gold-100)] text-[var(--color-gold-800)] text-sm font-bold">
                  {hero.author.split(" ").slice(0, 2).map((p) => p[0]).join("")}
                </span>
                <span>
                  <span itemprop="name" class="block text-sm font-semibold text-[var(--foreground)]">{hero.author}</span>
                  <span class="block text-xs text-[var(--foreground-muted)]">
                    {hero.country ? `${flagMap[hero.country] ?? ""} ${hero.country}` : ""}
                  </span>
                </span>
              </div>
              <span class="inline-flex items-center gap-1.5 text-[11px] uppercase tracking-widest text-[var(--foreground-subtle)]">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Verified on Google
              </span>
            </figcaption>
          </figure>
        </Reveal>

        {/* Supporting reviews — quieter, two-up */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-2 border-t border-[var(--border)]">
          {supporting.map((r, i) => (
            <Reveal variant="fade" class="pt-8" style={`animation-delay: ${(i + 1) * 100}ms;`}>
              <figure itemscope itemtype="https://schema.org/Review">
                <meta itemprop="datePublished" content={r.datePublished} />
                <div itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating">
                  <meta itemprop="ratingValue" content={String(r.rating)} />
                  <meta itemprop="bestRating" content="5" />
                </div>
                <blockquote itemprop="reviewBody" class="text-pretty text-[var(--foreground)] leading-relaxed" style="font-size: var(--text-base);">
                  <span class="text-[var(--color-gold-500)] italic" aria-hidden="true">“</span>{r.text}<span class="text-[var(--color-gold-500)] italic" aria-hidden="true">”</span>
                </blockquote>
                <figcaption itemprop="author" itemscope itemtype="https://schema.org/Person" class="mt-4 text-xs text-[var(--foreground-muted)]">
                  <span itemprop="name" class="font-semibold text-[var(--foreground)]">{r.author}</span>
                  {r.country && <> · {flagMap[r.country] ?? ""} {r.country}</>}
                </figcaption>
              </figure>
            </Reveal>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
