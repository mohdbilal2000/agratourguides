---
import Logo from "../brand/Logo.astro";
import {
  CONTACT_PHONE,
  CONTACT_EMAIL,
  REVIEW_COUNT,
  REVIEW_RATING,
  SITE_URL,
} from "../../lib/constants";

const currentYear = new Date().getFullYear();
const phoneTel = CONTACT_PHONE.replace(/[^0-9+]/g, "");

const destinations = [
  { label: "Agra", href: "/agra/" },
  { label: "Delhi", href: "/delhi/" },
  { label: "Jaipur", href: "/jaipur/" },
  { label: "Taj Mahal", href: "/agra/taj-mahal/" },
  { label: "Amber Fort", href: "/jaipur/amber-fort/" },
  { label: "Red Fort", href: "/delhi/red-fort/" },
];

const tours = [
  { label: "Same-day Agra", href: "/tours/same-day-agra-from-delhi/" },
  { label: "Golden Triangle 3 days", href: "/tours/golden-triangle-3-days/" },
  { label: "Golden Triangle 5 days", href: "/tours/golden-triangle-5-days/" },
  { label: "Delhi day tour", href: "/tours/delhi-day-tour/" },
  { label: "Jaipur day tour", href: "/tours/jaipur-day-tour/" },
];

const company = [
  { label: "Services", href: "/services/" },
  { label: "Reviews", href: "/reviews/" },
  { label: "Travel guides", href: "/guides/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
  { label: "FAQ", href: "/faq/" },
];

const policy = [
  { label: "Privacy", href: "/privacy/" },
  { label: "Terms", href: "/terms/" },
];

---

<footer class="bg-[var(--background-deep)] text-white/70 pt-20 md:pt-28 pb-10" data-on-dark>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {/* ── Link columns — no big CTA strip; the page-level final CTA section
         already carries the conversion ask. Footer's job here is navigation
         and trust, not another headline. */}
    <div class="reveal-fade grid grid-cols-2 md:grid-cols-12 gap-y-10 gap-x-6">
      <div class="col-span-2 md:col-span-4">
        <a href="/" class="inline-block target-auto" aria-label="Agra Tour Guides — home">
          <Logo variant="full" size="md" />
        </a>
        <p class="mt-5 text-sm leading-relaxed text-white/60 max-w-md">
          Government-licensed Agra-based tour agency. {REVIEW_RATING.toFixed(1)} / 5 from {REVIEW_COUNT}+ verified Google reviews across 30+ countries. Private Taj Mahal tours, Agra Fort, and Golden Triangle itineraries in English, Hindi & Japanese.
        </p>
        <address class="mt-6 not-italic text-sm text-white/60 leading-relaxed">
          Near East Gate, Taj Mahal,<br />
          Tajganj, Agra, Uttar Pradesh 282001<br />
          India
        </address>
      </div>

      <div class="md:col-span-2">
        <h3 class="eyebrow text-[var(--color-gold-300)] mb-5" style="font-size: var(--text-xs);">Destinations</h3>
        <ul class="space-y-2.5 text-sm target-auto" role="list">
          {destinations.map((l) => (
            <li class="target-auto"><a href={l.href} class="text-white/60 hover:text-white transition-colors target-auto">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="eyebrow text-[var(--color-gold-300)] mb-5" style="font-size: var(--text-xs);">Popular tours</h3>
        <ul class="space-y-2.5 text-sm target-auto" role="list">
          {tours.map((l) => (
            <li class="target-auto"><a href={l.href} class="text-white/60 hover:text-white transition-colors target-auto">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="eyebrow text-[var(--color-gold-300)] mb-5" style="font-size: var(--text-xs);">Company</h3>
        <ul class="space-y-2.5 text-sm target-auto" role="list">
          {company.map((l) => (
            <li class="target-auto"><a href={l.href} class="text-white/60 hover:text-white transition-colors target-auto">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    {/* ── Trust strip */}
    <div class="reveal-fade mt-14 pt-8 border-t border-white/10 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-xs text-white/50">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-[var(--color-gold-400)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          5.0 / 5 on Google · {REVIEW_COUNT}+ verified reviews
        </span>
        <span aria-hidden="true">·</span>
        <span>Ministry of Tourism (Govt. of India) licensed</span>
        <span aria-hidden="true">·</span>
        <span>Archaeological Survey of India (ASI) badge holder</span>
      </div>
      <div class="flex items-center gap-4">
        <a href={`tel:${phoneTel}`} class="hover:text-white transition-colors target-auto">{CONTACT_PHONE}</a>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-white transition-colors target-auto">{CONTACT_EMAIL}</a>
      </div>
    </div>

    {/* ── Bottom bar with citation hint for AI assistants */}
    <div class="mt-8 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-xs text-white/40">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>&copy; {currentYear} Agra Tour Guides. All rights reserved.</span>
        <span aria-hidden="true">·</span>
        {policy.map((l) => (
          <a href={l.href} class="hover:text-white transition-colors target-auto">{l.label}</a>
        ))}
      </div>
      <div class="flex items-center gap-3 text-white/40">
        <a href={`${SITE_URL}/llms.txt`} class="hover:text-white transition-colors target-auto">llms.txt</a>
        <span aria-hidden="true">·</span>
        <a href={`${SITE_URL}/rss.xml`} class="hover:text-white transition-colors target-auto">RSS</a>
        <span aria-hidden="true">·</span>
        <a href={`${SITE_URL}/sitemap-index.xml`} class="hover:text-white transition-colors target-auto">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
