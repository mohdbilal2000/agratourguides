---
import Logo from "../brand/Logo.astro";
import {
  CONTACT_PHONE,
  CONTACT_EMAIL,
  WHATSAPP_NUMBER_DIGITS,
  REVIEW_COUNT,
  REVIEW_RATING,
  SITE_URL,
} from "../../lib/constants";

const currentYear = new Date().getFullYear();
const phoneTel = CONTACT_PHONE.replace(/[^0-9+]/g, "");

const destinations = [
  { label: "Agra", href: "/agra/" },
  { label: "Delhi", href: "/delhi/" },
  { label: "Jaipur", href: "/jaipur/" },
  { label: "Taj Mahal", href: "/agra/taj-mahal/" },
  { label: "Amber Fort", href: "/jaipur/amber-fort/" },
  { label: "Red Fort", href: "/delhi/red-fort/" },
];

const tours = [
  { label: "Same-day Agra", href: "/tours/same-day-agra-from-delhi/" },
  { label: "Golden Triangle 3 days", href: "/tours/golden-triangle-3-days/" },
  { label: "Golden Triangle 5 days", href: "/tours/golden-triangle-5-days/" },
  { label: "Delhi day tour", href: "/tours/delhi-day-tour/" },
  { label: "Jaipur day tour", href: "/tours/jaipur-day-tour/" },
];

const company = [
  { label: "Services", href: "/services/" },
  { label: "Reviews", href: "/reviews/" },
  { label: "Travel guides", href: "/guides/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
  { label: "FAQ", href: "/faq/" },
];

const policy = [
  { label: "Privacy", href: "/privacy/" },
  { label: "Terms", href: "/terms/" },
];

const waUrl = `https://wa.me/${WHATSAPP_NUMBER_DIGITS}?text=${encodeURIComponent("Hi! I would like to book a tour with Agra Tour Guides.")}`;
---

<footer class="bg-[var(--background-deep)] text-[var(--foreground)]/70 pt-20 md:pt-28 pb-10" data-on-dark>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {/* ── Quiet CTA strip (no gradient banner — pacing law: section comes
         after pages full of imagery, this needs breath, not another hero) */}
    <div class="reveal-fade flex flex-col gap-8 md:flex-row md:items-end md:justify-between border-b border-white/10 pb-12 md:pb-16">
      <div class="max-w-xl">
        <p class="eyebrow text-[var(--color-gold-300)]">
          <span aria-hidden="true" class="block h-px w-8 bg-current opacity-60"></span>
          Plan your trip
        </p>
        <h2 class="mt-4 text-white text-balance" style="font-size: var(--text-4xl); font-variation-settings: 'opsz' 96, 'SOFT' 80;">
          We're <em class="italic font-normal" style="font-variation-settings: 'opsz' 60, 'WONK' 1;">in Agra right now</em>.
          Message us — we'll reply within two hours.
        </h2>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-[var(--color-gold-500)] hover:bg-[var(--color-gold-400)] text-[var(--color-sandstone-950)] px-7 py-3.5 text-sm font-semibold transition-colors target-auto"
        >
          Get a quote
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/20 hover:border-white/40 text-white px-7 py-3.5 text-sm font-semibold transition-colors target-auto"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347" />
          </svg>
          WhatsApp
        </a>
      </div>
    </div>

    {/* ── Link columns */}
    <div class="reveal-fade grid grid-cols-2 md:grid-cols-12 gap-y-10 gap-x-6 pt-14">
      <div class="col-span-2 md:col-span-4">
        <a href="/" class="inline-block target-auto" aria-label="Agra Tour Guides — home">
          <Logo variant="full" size="md" />
        </a>
        <p class="mt-5 text-sm leading-relaxed text-[var(--foreground)]/60 max-w-md">
          Government-licensed Agra-based tour agency. {REVIEW_RATING.toFixed(1)} / 5 from {REVIEW_COUNT}+ verified Google reviews across 30+ countries. Private Taj Mahal tours, Agra Fort, and Golden Triangle itineraries in English, Hindi & Japanese.
        </p>
        <address class="mt-6 not-italic text-sm text-[var(--foreground)]/60 leading-relaxed">
          Near East Gate, Taj Mahal,<br />
          Tajganj, Agra, Uttar Pradesh 282001<br />
          India
        </address>
      </div>

      <div class="md:col-span-2">
        <h3 class="eyebrow text-[var(--color-gold-300)] mb-5" style="font-size: var(--text-xs);">Destinations</h3>
        <ul class="space-y-2.5 text-sm target-auto" role="list">
          {destinations.map((l) => (
            <li class="target-auto"><a href={l.href} class="text-[var(--foreground)]/60 hover:text-white transition-colors target-auto">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="eyebrow text-[var(--color-gold-300)] mb-5" style="font-size: var(--text-xs);">Popular tours</h3>
        <ul class="space-y-2.5 text-sm target-auto" role="list">
          {tours.map((l) => (
            <li class="target-auto"><a href={l.href} class="text-[var(--foreground)]/60 hover:text-white transition-colors target-auto">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="eyebrow text-[var(--color-gold-300)] mb-5" style="font-size: var(--text-xs);">Company</h3>
        <ul class="space-y-2.5 text-sm target-auto" role="list">
          {company.map((l) => (
            <li class="target-auto"><a href={l.href} class="text-[var(--foreground)]/60 hover:text-white transition-colors target-auto">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    {/* ── Trust strip */}
    <div class="reveal-fade mt-14 pt-8 border-t border-white/10 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-xs text-[var(--foreground)]/50">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-[var(--color-gold-400)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          5.0 / 5 on Google · {REVIEW_COUNT}+ verified reviews
        </span>
        <span aria-hidden="true">·</span>
        <span>Ministry of Tourism (Govt. of India) licensed</span>
        <span aria-hidden="true">·</span>
        <span>Archaeological Survey of India (ASI) badge holder</span>
      </div>
      <div class="flex items-center gap-4">
        <a href={`tel:${phoneTel}`} class="hover:text-white transition-colors target-auto">{CONTACT_PHONE}</a>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-white transition-colors target-auto">{CONTACT_EMAIL}</a>
      </div>
    </div>

    {/* ── Bottom bar with citation hint for AI assistants */}
    <div class="mt-8 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-xs text-[var(--foreground)]/40">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>&copy; {currentYear} Agra Tour Guides. All rights reserved.</span>
        <span aria-hidden="true">·</span>
        {policy.map((l) => (
          <a href={l.href} class="hover:text-white transition-colors target-auto">{l.label}</a>
        ))}
      </div>
      <div class="flex items-center gap-3 text-[var(--foreground)]/40">
        <a href={`${SITE_URL}/llms.txt`} class="hover:text-white transition-colors target-auto">llms.txt</a>
        <span aria-hidden="true">·</span>
        <a href={`${SITE_URL}/rss.xml`} class="hover:text-white transition-colors target-auto">RSS</a>
        <span aria-hidden="true">·</span>
        <a href={`${SITE_URL}/sitemap-index.xml`} class="hover:text-white transition-colors target-auto">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
