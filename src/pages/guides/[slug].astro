---
import PageLayout from "../../layouts/PageLayout.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import GuideCard from "../../components/cards/GuideCard.astro";
import NativeFAQ from "../../components/ui/NativeFAQ.astro";
import CTABanner from "../../components/sections/CTABanner.astro";
import { getCollection, render } from "astro:content";
import {
  buildArticleSchema,
  buildFAQSchema,
  buildBreadcrumbSchema,
  buildOrganizationSchema,
  buildHowToSchema,
  buildGraph,
} from "../../lib/schema";
import { SITE_NAME, SITE_URL } from "../../lib/constants";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({
    params: { slug: guide.data.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

// Reading time + word count from the raw markdown body.
const words = (guide.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 220));
const timeRequired = `PT${readingMinutes}M`;

// Table of contents: only h2/h3, skip the auto-injected ones.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const categoryLabel = guide.data.category
  .replace(/-/g, " ")
  .replace(/\b\w/g, (l: string) => l.toUpperCase());

const allGuides = await getCollection("guides");
const relatedGuides = allGuides
  .filter((g) => g.data.slug !== guide.data.slug)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const guideImages: Record<string, string> = {
  "best-time-to-visit-taj-mahal": "https://images.unsplash.com/photo-1564507592333-c60657eea523?w=600&q=80",
  "delhi-to-agra-how-to-reach": "https://images.unsplash.com/photo-1587474260584-136574528ed5?w=600&q=80",
  "golden-triangle-itinerary-planning": "https://images.unsplash.com/photo-1599661046289-e31897846e41?w=600&q=80",
};

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Guides", href: "/guides/" },
  { label: guide.data.title },
];

const howToEntity = guide.data.category === "how-to-reach"
  ? buildHowToSchema({
      name: guide.data.title,
      description: guide.data.description,
      url: `${SITE_URL}/guides/${guide.data.slug}/`,
      totalTime: "PT4H",
      estimatedCost: { currency: "USD", value: 25 },
      steps: [
        { name: "Choose your transport mode", text: "Decide between Gatimaan Express train (fastest), private AC cab (most flexible), or Volvo bus (cheapest)." },
        { name: "Book your ticket / arrange the cab", text: "Trains: IRCTC.co.in or station counter; cabs: message us; buses: UP SRTC counter at Sarai Kale Khan ISBT." },
        { name: "Arrive at the departure point", text: "For trains, Hazrat Nizamuddin Station 30 min before departure. For cabs, hotel-pickup is included." },
        { name: "Travel 200-230 km via Yamuna Expressway", text: "3 hrs 30 min by cab, 1 hr 40 min by Gatimaan train. Three toll plazas on the expressway." },
        { name: "Arrive at Agra Cantt or your Agra hotel", text: "Agra Cantt station is 5 km from the Taj Mahal — a ₹150 e-rickshaw ride or our pre-arranged driver." },
      ],
    })
  : null;

const jsonLd = [
  buildGraph([
    buildOrganizationSchema(),
    buildArticleSchema({
      title: guide.data.title,
      description: guide.data.description,
      author: guide.data.author,
      publishedAt: guide.data.publishedAt,
      updatedAt: guide.data.updatedAt,
      heroImage: guide.data.heroImage,
      url: `${SITE_URL}/guides/${guide.data.slug}/`,
      keyTakeaways: guide.data.keyTakeaways,
      sources: guide.data.sources,
      wordCount: words,
      timeRequired,
    }),
    ...(howToEntity ? [howToEntity] : []),
    buildFAQSchema(guide.data.faqs),
    buildBreadcrumbSchema([
      { name: "Home", url: SITE_URL },
      { name: "Guides", url: `${SITE_URL}/guides/` },
      { name: guide.data.title, url: `${SITE_URL}/guides/${guide.data.slug}/` },
    ]),
  ]),
];

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<PageLayout
  title={`${guide.data.metaTitle} — ${SITE_NAME}`}
  description={guide.data.metaDescription}
  jsonLd={jsonLd}
  articlePublished={guide.data.publishedAt.toISOString()}
  articleModified={guide.data.updatedAt.toISOString()}
  articleAuthor="Pawan Agarwal"
>
  {/* Scroll-driven reading progress bar */}
  <div class="reading-progress" aria-hidden="true"></div>

  {/* Article masthead — editorial, no image, pure typography */}
  <header class="bg-[var(--color-ink-950)] text-white pt-28 md:pt-36 pb-16 md:pb-20" data-on-dark>
    <Container>
      <div class="max-w-3xl">
        <p class="eyebrow text-[var(--color-gold-300)]">
          <span aria-hidden="true" class="block h-px w-8 bg-current opacity-70"></span>
          {categoryLabel}
        </p>
        <h1 class="mt-5 heading-display text-white text-balance" style="font-size: var(--text-5xl);">
          {guide.data.title}
        </h1>
        <p class="mt-6 text-white/75 text-pretty leading-relaxed" style="font-size: var(--text-xl);">
          {guide.data.description}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-white/60">
          <span class="inline-flex items-center gap-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[var(--color-gold-500)] text-[var(--color-ink-950)] text-xs font-bold">PA</span>
            By Pawan Agarwal
          </span>
          <span aria-hidden="true" class="opacity-40">·</span>
          <span class="text-mono">{readingMinutes} min read</span>
          <span aria-hidden="true" class="opacity-40">·</span>
          <time datetime={guide.data.updatedAt.toISOString()}>Updated {fmtDate(guide.data.updatedAt)}</time>
        </div>
      </div>
    </Container>
  </header>

  <Section class="bg-[var(--background)]">
    <Container>
      <Breadcrumbs items={breadcrumbs} />

      <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
        {/* Sticky TOC — desktop only */}
        {toc.length > 2 && (
          <aside class="hidden lg:block lg:col-span-3">
            <nav class="sticky top-28" aria-label="On this page">
              <p class="eyebrow mb-4" style="font-size: 0.7rem;">On this page</p>
              <ul class="space-y-2.5 border-l border-[var(--border)] target-auto" role="list">
                {toc.map((h) => (
                  <li class:list={["target-auto", h.depth === 3 && "pl-3"]}>
                    <a
                      href={`#${h.slug}`}
                      class="block -ml-px border-l-2 border-transparent pl-3 text-sm text-[var(--foreground-muted)] hover:text-[var(--color-gold-700)] hover:border-[var(--color-gold-500)] transition-colors target-auto"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}

        {/* Article body */}
        <article class:list={["min-w-0", toc.length > 2 ? "lg:col-span-9 lg:max-w-3xl" : "lg:col-span-8 lg:col-start-3"]}>
          {/* Key takeaways — TL;DR box. LLMs lift these; readers skim them. */}
          {guide.data.keyTakeaways && guide.data.keyTakeaways.length > 0 && (
            <aside class="mb-12 rounded-2xl border border-[var(--border-strong)] bg-[var(--background-alt)] p-6 md:p-8" aria-label="Key takeaways">
              <p class="eyebrow mb-4">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" stroke-linejoin="round"/>
                </svg>
                Key takeaways
              </p>
              <ul class="space-y-3 target-auto" role="list">
                {guide.data.keyTakeaways.map((k) => (
                  <li class="flex items-start gap-3 text-[var(--foreground)] leading-relaxed">
                    <svg class="h-5 w-5 mt-0.5 text-[var(--color-gold-600)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                      <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>{k}</span>
                  </li>
                ))}
              </ul>
            </aside>
          )}

          <div class="article-prose">
            <Content />
          </div>

          {/* Sources / citations */}
          {guide.data.sources && guide.data.sources.length > 0 && (
            <footer class="mt-14 pt-8 border-t border-[var(--border)]">
              <p class="eyebrow mb-4" style="font-size: 0.7rem;">Sources</p>
              <ul class="space-y-2 text-sm target-auto" role="list">
                {guide.data.sources.map((s, i) => (
                  <li class="text-[var(--foreground-muted)] target-auto">
                    <span class="text-mono text-[var(--foreground-subtle)] mr-2">{i + 1}.</span>
                    <a href={s.url} target="_blank" rel="noopener nofollow" class="underline underline-offset-2 hover:text-[var(--color-gold-700)] target-auto">{s.label}</a>
                  </li>
                ))}
              </ul>
            </footer>
          )}

          {/* Author card — E-E-A-T */}
          <aside class="mt-12 flex items-start gap-4 rounded-2xl bg-[var(--background-alt)] border border-[var(--border)] p-6">
            <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[var(--color-gold-500)] text-[var(--color-ink-950)] font-bold">PA</span>
            <div>
              <p class="font-semibold text-[var(--foreground)]">Pawan Agarwal</p>
              <p class="text-sm text-[var(--foreground-muted)] mt-1 leading-relaxed">
                Founding guide at Agra Tour Guides. Ministry of Tourism-licensed, ASI-badged, born in Tajganj. 12 years guiding the Taj Mahal; 5.0 / 5 from 85+ travellers across 30+ countries. Speaks English, Hindi & Japanese.
              </p>
              <a href="/about/" class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-gold-700)] hover:text-[var(--color-gold-800)] target-auto">
                More about the team
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </aside>
        </article>
      </div>
    </Container>
  </Section>

  {/* FAQs */}
  {guide.data.faqs.length > 0 && (
    <Section class="bg-[var(--background-alt)]" id="faqs">
      <Container>
        <div class="max-w-3xl mx-auto">
          <h2 class="text-balance mb-8" style="font-size: var(--text-3xl); font-variation-settings: 'opsz' 72;">
            Frequently asked questions
          </h2>
          <NativeFAQ items={guide.data.faqs} idPrefix="guide-faq" />
        </div>
      </Container>
    </Section>
  )}

  {/* Related reading */}
  {relatedGuides.length > 0 && (
    <Section class="bg-[var(--background)]">
      <Container>
        <h2 class="text-balance mb-10" style="font-size: var(--text-3xl); font-variation-settings: 'opsz' 72;">
          Keep reading
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          {relatedGuides.map((g) => (
            <GuideCard
              title={g.data.title}
              slug={g.data.slug}
              image={guideImages[g.data.slug] || g.data.heroImage}
              description={g.data.description}
              category={g.data.category}
            />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <CTABanner
    title="Planning the trip these guides describe?"
    subtitle="WhatsApp us your dates — we'll turn any of this into a quoted itinerary within two hours."
    ctaText="Get my itinerary"
    ctaLink="/contact/"
  />
</PageLayout>
