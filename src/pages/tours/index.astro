---
import PageLayout from "../../layouts/PageLayout.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import AnswerBlock from "../../components/ui/AnswerBlock.astro";
import Reveal from "../../components/ui/Reveal.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import TourCard from "../../components/cards/TourCard.astro";
import CTABanner from "../../components/sections/CTABanner.astro";
import { getCollection } from "astro:content";
import {
  buildOrganizationSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildFAQSchema,
  buildGraph,
} from "../../lib/schema";
import { SITE_NAME, SITE_URL } from "../../lib/constants";

const allTours = await getCollection("tours");
const tours = allTours.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const tourImages: Record<string, string> = {
  "golden-triangle-3-days": "https://images.unsplash.com/photo-1564507592333-c60657eea523?w=800&q=80",
  "golden-triangle-5-days": "https://images.unsplash.com/photo-1599661046289-e31897846e41?w=800&q=80",
  "same-day-agra-from-delhi": "https://images.unsplash.com/photo-1564507592333-c60657eea523?w=800&q=80",
  "agra-overnight-from-delhi": "https://images.unsplash.com/photo-1564507592333-c60657eea523?w=800&q=80",
  "delhi-day-tour": "https://images.unsplash.com/photo-1587474260584-136574528ed5?w=800&q=80",
  "jaipur-day-tour": "https://images.unsplash.com/photo-1477587458883-47145ed94245?w=800&q=80",
};

const tourFaqs = [
  {
    question: "Can I customize a tour itinerary?",
    answer:
      "Yes — and most people do. Every tour on this page is a starting template, not a fixed package. WhatsApp us your dates, group size, must-see monuments and pace preference; we adjust the route, add or drop stops, and send a written quote within two hours. About 60% of our travellers end up booking a customised version rather than the template as written, and customising costs nothing extra.",
  },
  {
    question: "What's your cancellation policy across all tours?",
    answer:
      "Free cancellation up to 24 hours before the tour start for day tours; 72 hours for multi-day Golden Triangle packages. Inside those windows we charge only the costs already paid out — hotel deposits, train tickets — never our guide fee. Flight delays and genuine emergencies are always reschedulable at no charge.",
  },
  {
    question: "Are tours available in languages other than English?",
    answer:
      "In-house guides speak English, Hindi and Japanese fluently. For French, Spanish, German, Italian, Russian, Arabic, Mandarin or Korean we coordinate vetted partner guides — all government-licensed — with 48 hours' notice. Request the language when you message us; we'll confirm availability for your specific dates and tour.",
  },
  {
    question: "How early should I book in peak season?",
    answer:
      "October to March is peak season. Two weeks' lead time is comfortable for day tours; one month for the Golden Triangle. December sunrise Taj slots often book out 5–7 days ahead. For April to September we accept same-day bookings most of the time — just WhatsApp us and we'll confirm a guide for the next morning.",
  },
  {
    question: "Is monument entry included in the tour?",
    answer:
      "On Guide-Only tours you buy your own foreigner ticket at the gate. On Guide + Cab and Golden Triangle itineraries we pre-book entry tickets online so you skip the queue, and they are itemised separately on your quote. We never mark tickets up — the printed receipt matches the government rate to the rupee, and we hand it to you.",
  },
];

const itemList = buildItemListSchema(
  "Agra Tour Guides — published tour itineraries",
  tours.map((t) => ({
    name: t.data.title,
    url: `${SITE_URL}/tours/${t.data.slug}/`,
    description: `${t.data.duration}. Customisable itinerary, quoted per group. ${t.data.description.slice(0, 110)}${t.data.description.length > 110 ? "…" : ""}`,
    image: tourImages[t.data.slug] || t.data.heroImage,
  })),
);

const pageUrl = `${SITE_URL}/tours/`;

const jsonLd = [
  buildGraph([
    buildOrganizationSchema(),
    buildBreadcrumbSchema([
      { name: "Home", url: SITE_URL + "/" },
      { name: "Tours", url: pageUrl },
    ]),
    itemList,
    buildFAQSchema(tourFaqs),
  ]),
];

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Tours" },
];

const categories = [
  { value: "all", label: "All tours" },
  { value: "golden-triangle", label: "Golden Triangle" },
  { value: "day-trip", label: "Day trips" },
  { value: "multi-day", label: "Multi-day" },
];

const lastUpdated = "April 2026";
---

<PageLayout
  title={`Tours & itineraries — ${SITE_NAME}`}
  description="Six starting itineraries from a 5.0★ Agra agency — same-day Agra from Delhi, Golden Triangle 3 & 5 days, Delhi and Jaipur day tours. Every route is customised to your dates, pace and group, then quoted individually."
  jsonLd={jsonLd}
>
  <Section class="bg-[var(--background)] pt-28 md:pt-36 pb-16">
    <Container>
      <Breadcrumbs items={breadcrumbs} />
      <Reveal variant="fade" class="mt-8 max-w-3xl">
        <SectionHeader
          eyebrow={`Tours · Updated ${lastUpdated}`}
          heading="Six starting points. Every trip is built around you."
          lede="Nothing here is a fixed package — these are the routes travellers ask for most, and each one is a template we reshape around your dates, pace, group and must-sees. Send us what you have in mind and we quote that itinerary in writing."
          align="left"
          as="h1"
        />
      </Reveal>
    </Container>
  </Section>

  <Section class="bg-[var(--background-alt)] py-16 md:py-20" aria-labelledby="tour-list">
    <Container>
      <h2 id="tour-list" class="sr-only">All published tours</h2>

      <div class="flex flex-wrap gap-2 mb-10">
        {categories.map((cat) => (
          <span class="px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-[var(--background)] text-[var(--foreground-muted)] border border-[var(--border)]">
            {cat.label}
          </span>
        ))}
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" role="list">
        {tours.map((tour) => (
          <li class="target-auto">
            <TourCard
              title={tour.data.title}
              slug={tour.data.slug}
              image={tourImages[tour.data.slug] || tour.data.heroImage}
              duration={tour.data.duration}
              highlights={tour.data.highlights.slice(0, 3)}
            />
          </li>
        ))}
      </ul>
    </Container>
  </Section>

  <section class="bg-[var(--background)] py-20 md:py-28" itemscope itemtype="https://schema.org/FAQPage" aria-labelledby="tours-faq">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-16">
        <Reveal variant="fade" class="lg:col-span-4 lg:sticky lg:top-32 lg:self-start">
          <SectionHeader
            eyebrow="Tours FAQ"
            heading="Customisation, cancellation, languages, lead time."
            lede="Plain answers to the five questions most travellers ask before booking."
            align="left"
            as="h2"
          />
        </Reveal>
        <div class="lg:col-span-8">
          <div class="divide-y divide-[var(--border)]">
            {tourFaqs.map((f, i) => (
              <AnswerBlock question={f.question} answer={f.answer} id={`tours-faq-${i + 1}`} />
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <CTABanner
    title="Don't see exactly what you want?"
    subtitle="We custom-build itineraries — Rajasthan, Varanasi, photography-focused, multi-week. Tell us what you have in mind."
    ctaText="Request custom tour"
    ctaLink="/contact/"
  />
</PageLayout>
