---
import PageLayout from "../layouts/PageLayout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import TrustBadges from "../components/sections/TrustBadges.astro";
import DayTimeline from "../components/sections/DayTimeline.astro";
import BentoDestinations from "../components/sections/BentoDestinations.astro";
import PopularTours from "../components/sections/PopularTours.astro";
import WhyChooseUs from "../components/sections/WhyChooseUs.astro";
import TestimonialStrip from "../components/sections/TestimonialStrip.astro";
import CTABanner from "../components/sections/CTABanner.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Reveal from "../components/ui/Reveal.astro";
import AnswerBlock from "../components/ui/AnswerBlock.astro";
import {
  buildOrganizationSchema,
  buildWebSiteSchema,
  buildFAQSchema,
  buildBreadcrumbSchema,
  buildGraph,
} from "../lib/schema";
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION } from "../lib/constants";

const homeFaqs = [
  {
    question: "How much does a Taj Mahal tour guide cost?",
    answer:
      "A private licensed Taj Mahal guide costs ₹1,800 (about $22 / €20) for a group of up to 5 people for a 1.5–2 hour tour. Foreigner monument entry (₹1,300 / $16) and the e-rickshaw to the gate (₹100 round-trip) are paid separately. Guide fee is fixed — no commission, no tipping pressure.",
  },
  {
    question: "What is the best time to visit the Taj Mahal?",
    answer:
      "October to March is peak season — pleasant 10–25°C, but the Taj also gets 30,000+ visitors per day. The single best time is sunrise (06:00 entry), when the marble glows pink-gold and crowds are roughly 80% lower. The Taj is closed every Friday for Jumu'ah prayer.",
  },
  {
    question: "Do I need a guide at the Taj Mahal or can I visit alone?",
    answer:
      "You can enter alone — only the ticket is mandatory. But without a guide you'll miss the inlay-stone meanings, the optical illusions in the minarets, the calligraphy translations, and the photo angles travellers come back wishing they'd known. Most of our 85 reviews mention \"didn't know I needed a guide until I had one.\"",
  },
  {
    question: "How do I book your Agra tour from abroad?",
    answer:
      "WhatsApp is the fastest channel — message us with travel dates, group size and language preference, and you'll get a quote within two hours (we're online 06:00–22:00 IST). Booking is free; you pay on the day of the tour, in cash (USD/EUR/INR all accepted) or by UPI.",
  },
  {
    question: "What languages do your guides speak?",
    answer:
      "In-house guides are fluent in English, Hindi and Japanese. For French, Spanish, German, Italian, Russian, Arabic and Mandarin, we coordinate with vetted partner guides certified by the Ministry of Tourism — request the language when you message us and we'll confirm availability for your dates.",
  },
  {
    question: "What is the Golden Triangle and how many days do I need?",
    answer:
      "The Golden Triangle is India's most-booked circuit: Delhi → Agra → Jaipur, roughly 720 km arranged in a triangle. Three days is the absolute minimum (one city per day with night travel). Five days is the comfortable pace and what 70% of our travellers choose. Seven days adds Fatehpur Sikri and a slower Jaipur.",
  },
  {
    question: "Are your guides government-licensed?",
    answer:
      "Yes. Every guide on our team holds a Ministry of Tourism (Government of India) licence and an Archaeological Survey of India (ASI) badge — the only legal credential to guide inside the Taj Mahal complex. Unlicensed \"guides\" loitering at the gate cannot enter with you and are a common scam.",
  },
  {
    question: "Do you arrange the car/taxi as well, or just the guide?",
    answer:
      "Both. We have four service tiers: Guide-Only (you arrange transport), Guide + Cab (AC sedan or SUV with verified driver), Guide + Cab + Hotel (multi-day Golden Triangle), and Custom Itinerary (we plan everything). Cabs are background-checked, English-speaking drivers — not random app rides.",
  },
];

// @graph composition — every entity linked by @id so LLMs and search
// engines see a single connected document instead of disjoint JSON-LD blocks.
const jsonLd = [
  buildGraph([
    buildOrganizationSchema(),
    buildWebSiteSchema(),
    buildFAQSchema(homeFaqs),
    buildBreadcrumbSchema([{ name: "Home", url: SITE_URL + "/" }]),
  ]),
];

const heroImage =
  "https://images.unsplash.com/photo-1564507592333-c60657eea523?w=2400&q=85&auto=format&fit=crop";
---

<PageLayout
  title={`${SITE_NAME} — Private Taj Mahal tours & Golden Triangle itineraries`}
  description={SITE_DESCRIPTION}
  jsonLd={jsonLd}
  preloadImage={heroImage}
  transparentHeader
>
  {/* 1. Cinematic hero — single primary decision above the fold */}
  <HeroSection backgroundImage={heroImage} />

  {/* 2. Quiet trust strip — first anchor after the visual punch */}
  <TrustBadges />

  {/* 3. Your day — client-centric scroll narrative. Puts the traveller
       inside their actual morning before we ever talk about ourselves. */}
  <DayTimeline />

  {/* 4. Destinations — editorial 2-up bento with a feature card */}
  <BentoDestinations />

  {/* 4. Tours — editorial cards, snap-rail on mobile, grid on desktop */}
  <PopularTours />

  {/* 5. Story — calm split section establishing E-E-A-T */}
  <WhyChooseUs />

  {/* 6. Reviews — one hero quote anchored by two supporting */}
  <TestimonialStrip />

  {/* 7. FAQs — AEO answer blocks. Each Q is an H3 with a 40-60 word answer
       below; .speakable-* classes match the FAQPage SpeakableSpecification. */}
  <section class="bg-[var(--background)] py-24 md:py-32" aria-labelledby="faq-heading" itemscope itemtype="https://schema.org/FAQPage">
    <div class="mx-auto max-w-[var(--site-max)] px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-16">
        <Reveal variant="fade" class="lg:col-span-4 lg:sticky lg:top-32 lg:self-start">
          <SectionHeader
            eyebrow="FAQ"
            heading="The questions travellers actually ask."
            lede="Pricing, visit logistics, security, dress code, the Friday-closed catch. Tap any answer to skip — the long version lives on the FAQ page."
            align="left"
            as="h2"
          />
          <a href="/faq/" class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-gold-700)] hover:text-[var(--color-gold-800)] transition-colors target-auto">
            All FAQ
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </Reveal>

        <div class="lg:col-span-8">
          <Reveal variant="fade">
            <div class="divide-y divide-[var(--border)]">
              {homeFaqs.map((f, i) => (
                <AnswerBlock question={f.question} answer={f.answer} id={`faq-${i + 1}`} />
              ))}
            </div>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  {/* 8. Final CTA — editorial closer */}
  <CTABanner />
</PageLayout>
